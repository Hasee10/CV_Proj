# ChequeVerify backend settings (all optional; defaults shown). Copy to your shell environment; no secrets are needed.
CV_MAX_UPLOAD_BYTES=8388608      # per uploaded file
CV_MAX_IMAGE_SIDE=6000           # px, longest side
CV_MAX_IMAGE_PIXELS=24000000     # width*height (decompression-bomb guard)
CV_INFERENCE_TIMEOUT_S=120       # per recognition call; returns 504 when exceeded
CV_MAX_CONCURRENCY=1             # simultaneous model calls (CPU); extra requests wait
CV_QUEUE_TIMEOUT_S=30            # max wait for a free slot before 503 "busy"
CV_TORCH_THREADS=0               # 0 = torch default
CV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
