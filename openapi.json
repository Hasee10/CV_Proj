{
 "openapi": "3.1.0",
 "info": {
  "title": "ChequeVerify API",
  "description": "Handwritten cheque amount recognition (LoGo-HTR, frozen checkpoint) and numeric-vs-written consistency check. Academic prototype for human review; not certified bank software. A match is not proof of authenticity. Scores are uncalibrated.",
  "version": "0.1.0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/api/model-info": {
   "get": {
    "summary": "Model Info",
    "operationId": "model_info_api_model_info_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/api/recognize": {
   "post": {
    "summary": "Recognize",
    "description": "Recognise one cropped amount field. field_type: numeric | written. mode: baseline | proposed.",
    "operationId": "recognize_api_recognize_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_recognize_api_recognize_post"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/verify": {
   "post": {
    "summary": "Verify",
    "description": "Either numeric_image + written_image, or cheque_image + numeric_roi + written_roi\n(user-selected normalised boxes [x0, y0, x1, y1]).",
    "operationId": "verify_api_verify_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_verify_api_verify_post"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/benchmark": {
   "get": {
    "summary": "Benchmark",
    "description": "Saved locked-test results (artifacts/M8). Never recomputed on request.",
    "operationId": "benchmark_api_benchmark_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Body_recognize_api_recognize_post": {
    "properties": {
     "image": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "Image"
     },
     "field_type": {
      "type": "string",
      "title": "Field Type"
     },
     "mode": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Mode"
     }
    },
    "type": "object",
    "required": [
     "image",
     "field_type"
    ],
    "title": "Body_recognize_api_recognize_post"
   },
   "Body_verify_api_verify_post": {
    "properties": {
     "mode": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Mode"
     },
     "numeric_image": {
      "anyOf": [
       {
        "type": "string",
        "contentMediaType": "application/octet-stream"
       },
       {
        "type": "null"
       }
      ],
      "title": "Numeric Image"
     },
     "written_image": {
      "anyOf": [
       {
        "type": "string",
        "contentMediaType": "application/octet-stream"
       },
       {
        "type": "null"
       }
      ],
      "title": "Written Image"
     },
     "cheque_image": {
      "anyOf": [
       {
        "type": "string",
        "contentMediaType": "application/octet-stream"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cheque Image"
     },
     "numeric_roi": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Numeric Roi"
     },
     "written_roi": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Written Roi"
     }
    },
    "type": "object",
    "title": "Body_verify_api_verify_post"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}